{
  "name": "apiqendra/api",
  "type": "project",
  "description": "API integration and reliable webhook relay",
  "license": "MIT",
  "require": {
    "php": "^8.3",
    "laravel/framework": "^13.0",
    "laravel/sanctum": "^4.0",
    "predis/predis": "^3.0"
  },
  "require-dev": {
    "laravel/pint": "^1.26",
    "mockery/mockery": "^1.6.10",
    "phpunit/phpunit": "^12.0"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/",
      "Database\\Seeders\\": "database/seeders/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "post-autoload-dump": [
      "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
      "@php artisan package:discover --ansi"
    ],
    "test": "@php vendor/bin/phpunit",
    "lint": "pint --test"
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "conflict": {
    "symfony/mime": "<7.4.22 || >=8.0,<8.1.10"
  }
}
